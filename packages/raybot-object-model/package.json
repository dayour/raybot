{
  "name": "@raybot/object-model",
  "version": "1.0.0",
  "description": "TypeScript object model and JSON Schemas for Raybot, the Copilot Studio Coral runtime, and the ground-truth UI/API audit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schemas": "node scripts/emit-schemas.mjs",
    "validate-data": "node scripts/validate-data.mjs"
  },
  "keywords": [
    "raybot",
    "copilot-studio",
    "coral",
    "ray",
    "object-model",
    "json-schema"
  ],
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "~5.6.2"
  },
  "engines": {
    "node": ">=20.0"
  }
}
